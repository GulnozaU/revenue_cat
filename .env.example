# stylebox — environment variables (server-side only)

# Shipathon demo: mock = deterministic EditPlan, zero external AI calls
# real = NVIDIA primary → Gemini fallback
AI_MODE=mock
NEXT_PUBLIC_AI_MODE=mock

# Real AI keys (only used when AI_MODE=real)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

STORAGE_PROVIDER=local

# LOCAL DEV ONLY — optional Mac FFmpeg for smoke scripts (not used in production)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

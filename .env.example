# Cutline environment

# Primary AI (server-side only — never expose to the browser)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Fallback AI (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional legacy keys (not required for core flow)
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=

STORAGE_PROVIDER=local

# LOCAL DEV ONLY — optional path overrides for optional Mac smoke scripts
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Cutline — environment variables
# Copy to .env.local and fill in as needed.
# Missing keys automatically fall back to realistic mock/demo behavior.

# LLM for structured edit plans (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Transcription (optional — falls back to mock transcript)
# OPENAI_API_KEY also enables Whisper transcription when available
DEEPGRAM_API_KEY=

# Storage: local | cloud
STORAGE_PROVIDER=local
# STORAGE_BUCKET=
# STORAGE_PUBLIC_URL=

# Set to 1 to attempt real ffmpeg execution (experimental)
FF_RENDER=0
